"""
optimiser.py
============
Multi-market co-optimisation of a NEM battery across energy + the full FCAS
stack, the way batteries actually earn in Australia.

Markets co-optimised simultaneously (all clear in the same 5-min dispatch):
  - Energy arbitrage (RRP)
  - 4 contingency-RAISE services (R6SEC, R60SEC, R5MIN, R1SEC)
  - 4 contingency-LOWER services (L6SEC, L60SEC, L5MIN, L1SEC)
  - 2 regulation services (RAISEREG, LOWERREG) — continuously utilised

The battery's single power rating and energy store are SHARED across all
markets, so this is a genuine co-optimisation, not separate stacking. FCAS is
paid on ENABLED capacity (MW), whether or not activated — except regulation,
which is utilised and so carries an energy/throughput cost.

Key constraints (per 5-min interval t):
  Power split:    charge + Σlower_enablement + lower_reg  ≤ P
                  discharge + Σraise_enablement + raise_reg ≤ P
  SoC dynamics:   cumulative energy within [SoC_min, SoC_max]
  Energy security for FCAS: enough stored energy / headroom to deliver enabled
                  contingency response if called (approximated as a SoC reserve).
  Regulation throughput: reg enablement consumes/absorbs energy at a utilisation
                  factor, adding a cycle cost.

Solved as a linear program (scipy HiGHS): fast and globally optimal.
"""

import numpy as np
from scipy.optimize import linprog

RAISE = ["R6SEC", "R60SEC", "R5MIN", "R1SEC"]
LOWER = ["L6SEC", "L60SEC", "L5MIN", "L1SEC"]


class Battery:
    def __init__(self, power_mw=100.0, duration_h=2.0, rte=0.88,
                 cycle_cost_per_mwh=4.5, soc_min_frac=0.05, soc_max_frac=0.95,
                 reg_utilisation=0.15):
        self.power_mw = power_mw
        self.energy_mwh = power_mw * duration_h
        self.rte = rte
        self.eff = np.sqrt(rte)
        self.cycle_cost = cycle_cost_per_mwh
        self.soc_min = soc_min_frac * self.energy_mwh
        self.soc_max = soc_max_frac * self.energy_mwh
        self.reg_util = reg_utilisation


def optimise_day(prices: dict, batt: Battery, dt_h: float,
                 enable_fcas=True, enable_reg=True, enable_vf=True) -> dict:
    """
    prices: dict of arrays keyed by 'RRP', RAISE/LOWER services, 'RAISEREG','LOWERREG'.
    Returns revenue breakdown and dispatch arrays.

    Variable blocks (each length T):
      0: charge, 1: discharge,
      2..5: raise enablements (R6,R60,R5,R1),
      6..9: lower enablements (L6,L60,L5,L1),
      10: raise_reg, 11: lower_reg
    """
    p_e = prices["RRP"]
    T = len(p_e)
    P = batt.power_mw
    NV = 12  # number of variable blocks

    raise_svcs = RAISE if (enable_fcas) else []
    lower_svcs = LOWER if (enable_fcas) else []
    if not enable_vf:
        raise_svcs = [s for s in raise_svcs if s != "R1SEC"]
        lower_svcs = [s for s in lower_svcs if s != "L1SEC"]

    def block(b, t):
        return b * T + t

    # ---- objective (minimise -revenue) ----
    c = np.zeros(NV * T)
    c[block(0, 0):block(0, 0) + T] = p_e * dt_h + batt.cycle_cost * dt_h        # charge: pay energy + cycle
    c[block(1, 0):block(1, 0) + T] = -p_e * dt_h * batt.eff + batt.cycle_cost * dt_h  # discharge
    for i, svc in enumerate(RAISE):
        if svc in raise_svcs:
            c[block(2 + i, 0):block(2 + i, 0) + T] = -prices[svc] * dt_h
    for i, svc in enumerate(LOWER):
        if svc in lower_svcs:
            c[block(6 + i, 0):block(6 + i, 0) + T] = -prices[svc] * dt_h
    if enable_reg:
        # regulation paid on enablement, but utilised -> add throughput cost
        c[block(10, 0):block(10, 0) + T] = -prices["RAISEREG"] * dt_h + batt.reg_util * batt.cycle_cost * dt_h
        c[block(11, 0):block(11, 0) + T] = -prices["LOWERREG"] * dt_h + batt.reg_util * batt.cycle_cost * dt_h

    # ---- variable bounds ----
    bounds = []
    for b in range(NV):
        for t in range(T):
            if b in (2, 3, 4, 5) and RAISE[b - 2] not in raise_svcs:
                bounds.append((0, 0))
            elif b in (6, 7, 8, 9) and LOWER[b - 6] not in lower_svcs:
                bounds.append((0, 0))
            elif b in (10, 11) and not enable_reg:
                bounds.append((0, 0))
            else:
                bounds.append((0, P))

    A_ub, b_ub = [], []

    # Power-headroom: discharge + Σraise + raise_reg <= P ; charge + Σlower + lower_reg <= P
    for t in range(T):
        r_up = np.zeros(NV * T)
        r_up[block(1, t)] = 1
        for i in range(4):
            r_up[block(2 + i, t)] = 1
        r_up[block(10, t)] = 1
        A_ub.append(r_up); b_ub.append(P)

        r_dn = np.zeros(NV * T)
        r_dn[block(0, t)] = 1
        for i in range(4):
            r_dn[block(6 + i, t)] = 1
        r_dn[block(11, t)] = 1
        A_ub.append(r_dn); b_ub.append(P)

    # SoC bounds via cumulative balance (energy + regulation utilisation)
    soc_start = 0.5 * batt.energy_mwh
    for t in range(T):
        coeff = np.zeros(NV * T)
        for k in range(t + 1):
            coeff[block(0, k)] = batt.eff * dt_h           # charge adds
            coeff[block(1, k)] = -(1 / batt.eff) * dt_h     # discharge removes
            # regulation: raise_reg discharges, lower_reg charges, at utilisation
            coeff[block(10, k)] = -batt.reg_util * dt_h
            coeff[block(11, k)] = batt.reg_util * dt_h
        A_ub.append(coeff.copy()); b_ub.append(batt.soc_max - soc_start)
        A_ub.append(-coeff); b_ub.append(-(batt.soc_min - soc_start))

    res = linprog(c, A_ub=np.array(A_ub), b_ub=np.array(b_ub), bounds=bounds, method="highs")
    if not res.success:
        return {"ok": False, "total": 0.0}

    x = res.x
    chg = x[block(0, 0):block(0, 0) + T]
    dis = x[block(1, 0):block(1, 0) + T]

    energy_rev = float(np.sum(p_e * dt_h * (dis * batt.eff - chg)))
    cont_rev = 0.0
    svc_rev = {}
    for i, svc in enumerate(RAISE):
        v = x[block(2 + i, 0):block(2 + i, 0) + T]
        r = float(np.sum(prices[svc] * v * dt_h)); svc_rev[svc] = r; cont_rev += r
    for i, svc in enumerate(LOWER):
        v = x[block(6 + i, 0):block(6 + i, 0) + T]
        r = float(np.sum(prices[svc] * v * dt_h)); svc_rev[svc] = r; cont_rev += r
    reg_rev = 0.0
    if enable_reg:
        rr = x[block(10, 0):block(10, 0) + T]
        lr = x[block(11, 0):block(11, 0) + T]
        reg_rev = float(np.sum(prices["RAISEREG"] * rr * dt_h + prices["LOWERREG"] * lr * dt_h))

    cycle_cost = float(np.sum(batt.cycle_cost * dt_h * (dis + chg)))
    total = energy_rev + cont_rev + reg_rev - cycle_cost

    return {"ok": True, "energy_rev": energy_rev, "contingency_rev": cont_rev,
            "regulation_rev": reg_rev, "cycle_cost": cycle_cost, "total": total,
            "svc_rev": svc_rev, "chg": chg, "dis": dis}
